# ASN Asset Mapper — example environment file.
# Copy to `.env` (or export in your shell) and fill in values.
# NEVER commit real secrets. Core functionality needs NO API keys.

# ---------------------------------------------------------------------------
# Optional provider API keys (not required for the default public sources)
# ---------------------------------------------------------------------------
# BGPVIEW_API_KEY=
# CRTSH_API_KEY=
# RIPESTAT_API_KEY=
# HACKERTARGET_API_KEY=

# ---------------------------------------------------------------------------
# Behaviour overrides (AAM_* environment variables)
# ---------------------------------------------------------------------------
# AAM_TIMEOUT=15            # HTTP/DNS timeout in seconds
# AAM_RETRIES=3             # retries for transient failures
# AAM_THREADS=10            # worker threads for reverse DNS
# AAM_USER_AGENT=ASN-Asset-Mapper/1.0.0
# AAM_CACHE_TTL=86400       # cache TTL in seconds
# AAM_CACHE_DIR=~/.cache/asn-asset-mapper
# AAM_NO_CACHE=1            # set to disable the cache entirely
# AAM_DNS_TIMEOUT=4
# AAM_DNS_SAMPLE=2          # PTR samples per prefix
# AAM_DNS_MAX=256           # total PTR lookups per run
# AAM_MIN_INTERVAL=0.5      # minimum interval between API requests
# AAM_CUSTOM_BGP_PATH=/path/to/custom-bgp.json
# AAM_LOG_FILE=asn_mapper.log
